PHISHGUARD_ENV=dev
PHISHGUARD_API_KEY=change-me
PHISHGUARD_DB_URL=sqlite:///data/phishguard.db
PHISHGUARD_STORE_RAW=false
PHISHGUARD_REDACT_PII=true
PHISHGUARD_MAX_UPLOAD_MB=10
PHISHGUARD_RATE_LIMIT=30/minute
PHISHGUARD_TRUSTED_AUTHSERV_IDS=
PHISHGUARD_DOMAIN_AGE_ENABLED=false
PHISHGUARD_LLM_ENABLED=false
LLM_MODEL=gemini/gemini-2.5-flash
GEMINI_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_AUTH_KEY=
URLSCAN_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_ENABLED=true
URLHAUS_ENABLED=true
OPENPHISH_ENABLED=true
SAFEBROWSING_ENABLED=true
URLSCAN_ENABLED=true
PHISHGUARD_INTEL_DEADLINE_SECONDS=8.0
PHISHGUARD_INTEL_MAX_INDICATORS=5
PHISHGUARD_INTEL_SEND_FULL_URLS=false
OPENPHISH_MAX_FEED_BYTES=2097152
INTEL_CACHE_TTL_HOURS=24
LOG_LEVEL=INFO
